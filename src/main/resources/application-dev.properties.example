spring.datasource.url=CHANGE_ME
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.postgresql.Driver

logging.level.org.springframework=INFO
logging.level.com.example.gmsservice=DEBUG

spring.use-captcha=true
spring.send-mail=false

spring.upload-file-location=CHANGE_ME
spring.preview-file-location=CHANGE_ME

springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true
